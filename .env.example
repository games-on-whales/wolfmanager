# Feature flag for Game Library Page UI (public, used in client code)
NEXT_PUBLIC_FEATURE_GAME_LIBRARY_ENABLED=true # Set to 'true' to enable the Game Library Page UI

# Feature flag for background task execution (public, used in client code)
NEXT_PUBLIC_FEATURE_BACKGROUND_TASKS_ENABLED=true # Set to 'true' to enable background task execution

# Database Configuration
DATABASE_TYPE=sqlite # Options: sqlite, postgresql, mysql

# SQLite Configuration (default)
# Uses local file storage, perfect for development and small deployments
# DATABASE_URL is optional for SQLite, defaults to ./data/wolfmanager.db
# DATABASE_URL=file:./data/wolfmanager.db

# PostgreSQL Configuration (production recommended)
# Uncomment and configure for PostgreSQL
# DATABASE_TYPE=postgresql
# DATABASE_URL=postgresql://username:password@localhost:5432/wolfmanager
# For SSL connection:
# DATABASE_URL=postgresql://username:password@localhost:5432/wolfmanager?ssl=true
# For cloud databases (like AWS RDS):
# DATABASE_URL=postgresql://username:password@your-db-host:5432/wolfmanager?ssl=true&sslmode=require

# MySQL Configuration (alternative production option)
# Uncomment and configure for MySQL
# DATABASE_TYPE=mysql
# DATABASE_URL=mysql://username:password@localhost:3306/wolfmanager
# For SSL connection:
# DATABASE_URL=mysql://username:password@localhost:3306/wolfmanager?ssl=true

# Security Note: Always use strong passwords and SSL for production databases
# Example connection strings:
# Local PostgreSQL: postgresql://wolfmanager:secure_password@localhost:5432/wolfmanager
# Local MySQL: mysql://wolfmanager:secure_password@localhost:3306/wolfmanager
# Docker PostgreSQL: postgresql://wolfmanager:secure_password@postgres:5432/wolfmanager