# =============================================================================
# WolfManager Environment Configuration
# =============================================================================

# Authentication & Security Configuration
# ========================================
# NEXTAUTH_SECRET, ENCRYPTION_KEY, and INTERNAL_SERVICE_TOKEN are automatically
# generated at the Docker container level BEFORE Node.js startup if not provided.
# This ensures secure defaults and eliminates timing issues.
#
# Auto-generation uses openssl rand -hex for cryptographic security at the
# Docker level, ensuring secrets are available from the very first Node.js import.
# Generated secrets are saved to .env.local for persistence across restarts.
#
# Manual configuration (optional):
# NEXTAUTH_SECRET=your-64-character-secret-here         # Used for NextAuth.js session encryption (64 chars)
# ENCRYPTION_KEY=your-32-character-key-here             # Used for encrypting sensitive data (32 chars)
# INTERNAL_SERVICE_TOKEN=your-64-character-token-here   # Used for secure service communication (64 chars)
#
# Generate your own secrets (if preferred):
# openssl rand -hex 32  # For NEXTAUTH_SECRET (64 characters)
# openssl rand -hex 16  # For ENCRYPTION_KEY (32 characters)
# openssl rand -hex 32  # For INTERNAL_SERVICE_TOKEN (64 characters)
#
# Docker-Level Generation:
# - Secrets are generated using openssl at container startup
# - Available as environment variables before Node.js application starts
# - Idempotent: only generates missing or invalid-length secrets
# - Persistent: stored via symlink system (/app/.env.local -> /app/config/.env.local)

# Feature Flags
# =============
# Feature flag for Game Library Page UI (public, used in client code)
NEXT_PUBLIC_FEATURE_GAME_LIBRARY_ENABLED=true # Set to 'true' to enable the Game Library Page UI

# Feature flag for background task execution (public, used in client code)
NEXT_PUBLIC_FEATURE_BACKGROUND_TASKS_ENABLED=true # Set to 'true' to enable background task execution
# Feature flag for server-side SSE relay (internal, NOT exposed to browser)
# When enabled, the application relays Wolf UNIX socket /events stream to authenticated browsers
# via /api/events/stream (server-sent events) with periodic keep-alive heartbeats.
# Requires a valid Wolf socket (see README WOLF_SOCKET_PATH section).
SSE_RELAY_ENABLED=false # Set to 'true' to enable server-side SSE relay

# Database Configuration
DATABASE_TYPE=sqlite # Options: sqlite, postgresql, mysql

# SQLite Configuration (default)
# Uses local file storage, perfect for development and small deployments
# DATABASE_URL is optional for SQLite, defaults to ./data/wolfmanager.db
# DATABASE_URL=file:./data/wolfmanager.db

# PostgreSQL Configuration (production recommended)
# Uncomment and configure for PostgreSQL
# DATABASE_TYPE=postgresql
# DATABASE_URL=postgresql://username:password@localhost:5432/wolfmanager
# For SSL connection:
# DATABASE_URL=postgresql://username:password@localhost:5432/wolfmanager?ssl=true
# For cloud databases (like AWS RDS):
# DATABASE_URL=postgresql://username:password@your-db-host:5432/wolfmanager?ssl=true&sslmode=require

# MySQL Configuration (alternative production option)
# Uncomment and configure for MySQL
# DATABASE_TYPE=mysql
# DATABASE_URL=mysql://username:password@localhost:3306/wolfmanager
# For SSL connection:
# DATABASE_URL=mysql://username:password@localhost:3306/wolfmanager?ssl=true

# Security Note: Always use strong passwords and SSL for production databases
# Example connection strings:
# Local PostgreSQL: postgresql://wolfmanager:secure_password@localhost:5432/wolfmanager
# Local MySQL: mysql://wolfmanager:secure_password@localhost:3306/wolfmanager
# Docker PostgreSQL: postgresql://wolfmanager:secure_password@postgres:5432/wolfmanager

# Logging Configuration
# DEBUG_LOGS=true # Set to 'true' to enable additional debug logging (development only)