# Node.js dependencies
**/node_modules/
**/npm-debug.log
**/yarn-debug.log*
**/yarn-error.log*

# Build outputs
**/dist/
**/build/
**/.next/

# Git and version control
**/.git/
**/.gitignore
**/.gitattributes

# Documentation
**/README.md
**/LICENSE
**/CHANGELOG.md
**/docs/

# IDE and editor files
**/.vscode/
**/.idea/
**/.vs/
**/*.swp
**/*.swo
**/*~

# OS generated files
**/.DS_Store
**/Thumbs.db

# Environment and secrets
**/.env
**/.env.local
**/.env.*.local
**/.aws/
**/.ssh/

# Test and coverage
**/coverage/
**/.nyc_output/
**/test/
**/__tests__/
**/*.test.js
**/*.test.ts
**/*.spec.js
**/*.spec.ts

# Logs
**/logs/
**/*.log

# Runtime data
**/pids/
**/*.pid
**/*.seed
**/*.pid.lock

# Optional npm cache directory
**/.npm/

# ESLint cache
**/.eslintcache

# TypeScript cache
**/*.tsbuildinfo

# Temporary folders
**/tmp/
**/temp/

# Editor config
**/.editorconfig

# Docker files (don't copy docker files into docker)
**/Dockerfile*
**/docker-compose*
**/.dockerignore

# Package manager files (we copy these explicitly)
# Uncomment if you want to exclude them from general copy operations
# **/package-lock.json
# **/yarn.lock
# **/pnpm-lock.yaml