{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "wolfbuild",
            "type": "shell",
            "command": "docker buildx build --platform linux/amd64 -t wolf-manager .",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "wolfrun",
            "type": "shell",
            "command": "docker run --rm --name wolf-manager -p 9971:9971 -v /home/mbrine/dev/wolfmanger/config:/config -v /var/run/docker.sock:/var/run/docker.sock:rw -v /var/run/wolf:/var/run/wolf:rw -e NODE_ENV=production --log-driver json-file --log-opt max-size=10m --log-opt max-file=3 --log-opt labels=wolf-manager wolf-manager:latest",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "wolfbuild-and-run",
            "dependsOrder": "sequence",
            "dependsOn": ["wolfbuild", "wolfrun"],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        }
    ]
}