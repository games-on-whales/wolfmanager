// See https://containers.dev/implementors/json_reference/ for configuration reference
{
  "name": "Wolf Admin Development",
  "dockerFile": "Dockerfile",
  "forwardPorts": [3000],
  "appPort": ["3000:3000"],
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-vscode.vscode-typescript-next",
        "formulahendry.auto-rename-tag",
        "streetsidesoftware.code-spell-checker",
        "naumovs.color-highlight",
        "mikestead.dotenv",
        "dsznajder.es7-react-js-snippets",
        "wix.vscode-import-cost",
        "yoavbls.pretty-ts-errors",
        "csstools.postcss",
        "christian-kohler.path-intellisense",
        "rangav.vscode-thunder-client",
        "rooveterinaryinc.roo-cline",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": true,
          "source.organizeImports": true
        },
        "editor.quickSuggestions": {
          "strings": true
        },
        "tailwindCSS.includeLanguages": {
          "typescript": "javascript",
          "typescriptreact": "javascript"
        }
      }
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "remoteUser": "node",
  "updateRemoteUserUID": true,
  // Use postCreateCommand to set up docker group permissions and verify Docker tools
  "postCreateCommand": "if [ -S /var/run/docker.sock ]; then DOCKER_GID=$(stat -c '%g' /var/run/docker.sock); if ! getent group docker > /dev/null; then sudo groupadd -g $DOCKER_GID docker; else sudo groupmod -g $DOCKER_GID docker; fi; sudo usermod -aG docker node; newgrp docker; fi && docker --version && docker buildx version && echo 'Docker setup completed successfully'",
  "postStartCommand": "sleep 5 && sudo chmod 666 /var/run/wolf/wolf.sock || true && sudo chown root:node /var/run/wolf/wolf.sock && sudo chmod 660 /var/run/wolf/wolf.sock && pnpm install && npm rebuild bcrypt && npm rebuild sharp",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/WolfUI,type=bind,consistency=cached",
  "workspaceFolder": "/workspaces/WolfUI",
  "runArgs": [
    "--privileged",
    "--volume=/var/run/docker.sock:/var/run/docker.sock:rw",
    "--volume=/var/run/wolf:/var/run/wolf:rw"
  ]
}
