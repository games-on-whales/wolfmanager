{
  "mcpServers": {
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "env": {
        "MEMORY_FILE_PATH": "./memory.json"
      }
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "browser-tools": {
      "command": "npx",
      "args": ["-y @agentdeskai/browser-tools-mcp@1.2.0"],
      "enabled": true
    }
  }
}
